      "parameters": {
        "jsCode": "const allowed = ['billing', 'technical', 'general'];\nconst langs = ['az', 'en', 'ru'];\n\nconst original = $('Telegram Trigger').first().json.message;\nconst chatId = original.chat.id;\nconst text = original.text || '';\n\nlet category = 'unknown';\nlet language = 'en';\nlet error = null;\n\ntry {\n  const raw = $input.first().json.message.content;\n  const parsed = JSON.parse(raw);\n  const value = String(parsed.category || '').toLowerCase().trim();\n  category = allowed.includes(value) ? value : 'unknown';\n  const lang = String(parsed.language || '').toLowerCase().trim();\n  language = langs.includes(lang) ? lang : 'en';\n} catch (e) {\n  error = 'AI response was not valid JSON';\n}\n\nreturn [{\n  json: {\n    chatId,\n    text,\n    username: original.from.username || original.from.first_name || 'unknown',\n    timestamp: new Date().toISOString(),\n    category,\n    language,\n    error\n  }\n}];"
      },
