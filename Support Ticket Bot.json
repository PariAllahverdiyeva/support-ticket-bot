    {
      "parameters": {
        "jsCode": "const chatId = $('Is History?').first().json.message.chat.id;\nconst rows = $input.all().map(i => i.json).filter(r => r.timestamp);\n\nconst last5 = rows\n  .sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp))\n  .slice(0, 5);\n\nlet text;\nif (last5.length === 0) {\n  text = 'You have no tickets yet.';\n} else {\n  text = 'Your last ' + last5.length + ' tickets:\\n\\n' + last5.map((r, i) =>\n    (i + 1) + '. [' + r.category + '] ' + r.message + ' (' + String(r.timestamp).slice(0, 16).replace('T', ' ') + ' UTC)'\n  ).join('\\n');\n}\n\nreturn [{ json: { chatId, text } }];"
      },
