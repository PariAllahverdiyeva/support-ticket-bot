    {
      "parameters": {
        "jsCode": "const allowed = ['billing', 'technical', 'general'];\nconst langs = ['az', 'en', 'ru'];\n\nconst prev = $('Code in JavaScript').first().json;\n\nlet category = 'unknown';\nlet language = prev.language || 'en';\nlet error = prev.error;\n\ntry {\n  const raw = $input.first().json.message.content;\n  const parsed = JSON.parse(raw);\n  const value = String(parsed.category || '').toLowerCase().trim();\n  category = allowed.includes(value) ? value : 'unknown';\n  const lang = String(parsed.language || '').toLowerCase().trim();\n  if (langs.includes(lang)) language = lang;\n  if (category !== 'unknown') error = null;\n} catch (e) {\n  error = 'Retry response was not valid JSON';\n}\n\nreturn [{ json: { ...prev, category, language, error, retried: true } }];"
      },
